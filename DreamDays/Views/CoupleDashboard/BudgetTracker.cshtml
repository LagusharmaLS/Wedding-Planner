@model DreamDays.Models.CoupleDashboardViewModel

@{
    ViewData["Title"] = "Budget Tracker";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Navigation Bar -->
<nav class="navbar navbar-expand-lg navbar-dark" style="background-color: white; color: black;">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold gradient-text" href="/Home">
            <i class="fas fa-heart me-2"></i>DreamDays
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"] as string == "Dashboard" ? "active" : "")" asp-controller="Home" asp-action="CoupleDashboard">
                        <i class="fas fa-tachometer-alt me-1"></i>Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"] as string == "Checklist" ? "active" : "")" asp-controller="Home" asp-action="CoupleChecklist">
                        <i class="fas fa-check-square me-1"></i>Checklist
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"] as string == "GuestList" ? "active" : "")" asp-controller="Home" asp-action="CoupleGuestList">
                        <i class="fas fa-users me-1"></i>Guest List
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"] as string == "BudgetTracker" ? "active" : "")" asp-controller="Home" asp-action="CoupleBudgetTracker">
                        <i class="fas fa-wallet me-1"></i>Budget Tracker
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"] as string == "Timeline" ? "active" : "")" asp-controller="Home" asp-action="CoupleTimeline">
                        <i class="fas fa-calendar-alt me-1"></i>Timeline
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"] as string == "Vendors" ? "active" : "")" asp-controller="Home" asp-action="CoupleVendors">
                        <i class="fas fa-store me-1"></i>Vendors
                    </a>
                </li>
            </ul>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link btn btn-outline-light px-3" asp-controller="Auth" asp-action="Logout">
                        <i class="fas fa-sign-out-alt me-1"></i>Log Out
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- Main Content -->
<div class="container-fluid py-5" style="height: 100vh; background: linear-gradient(90deg, rgba(255, 111, 97, 0.2), rgba(255, 184, 140, 0.2)); background-image: url('https://images.unsplash.com/photo-1511285560929-80b456fea0bc?q=80&w=2069&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D'); background-repeat: no-repeat; background-position: center; background-size: cover; background-attachment: fixed;">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow mb-4 animate__animated animate__fadeIn">
                <div class="card-header text-center">
                    <h3 class="section-header">Budget Tracker</h3>
                </div>
                <div class="card-body">
                    <div id="budgetTrackerContent">
                        <table class="table table-bordered table-hover" id="budgetTrackerTable">
                            <thead class="card-gradient text-white">
                                <tr>
                                    <th>Category</th>
                                    <th>Allocated</th>
                                    <th>Spent</th>
                                    <th>Variance</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.BudgetCategoryIds.Any())
                                {
                                    @for (var i = 0; i < Model.BudgetCategoryIds.Count; i++)
                                    {
                                        var variance = Model.BudgetCategoryAllocatedAmounts[i] - Model.BudgetCategorySpentAmounts[i];
                                        <tr data-id="@Model.BudgetCategoryIds[i]">
                                            <td>@Model.BudgetCategoryCategories[i]</td>
                                            <td>$@Model.BudgetCategoryAllocatedAmounts[i].ToString("F2")</td>
                                            <td>$@Model.BudgetCategorySpentAmounts[i].ToString("F2")</td>
                                            <td style="color: @(variance < 0 ? "red" : "black");">$@variance.ToString("F2")</td>
                                            <td>
                                                <button class="btn btn-sm btn-gradient edit-btn"
                                                        data-id="@Model.BudgetCategoryIds[i]"
                                                        data-category="@Model.BudgetCategoryCategories[i]"
                                                        data-allocated="@Model.BudgetCategoryAllocatedAmounts[i]"
                                                        data-spent="@Model.BudgetCategorySpentAmounts[i]">
                                                    Edit
                                                </button>
                                                <button class="btn btn-sm btn-danger delete-btn" data-id="@Model.BudgetCategoryIds[i]">Delete</button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">No categories added yet.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button class="btn btn-gradient" id="addCategoryBtn" data-toggle="modal" data-target="#addBudgetCategoryModal">Add Category</button>
                    <button class="btn btn-gradient" id="exportPdfBtn">Download PDF Report</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Budget Category Modal -->
<div class="modal fade" id="addBudgetCategoryModal" tabindex="-1" role="dialog" aria-labelledby="addBudgetCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addBudgetCategoryModalLabel">Add Budget Category</h5>
                <button type="button" class="close" id="addBudgetCategoryCloseBtn" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="addBudgetCategoryForm">
                    <div class="form-group">
                        <label for="addCategory">Category</label>
                        <select class="form-control" id="addCategory" required>
                            <option value="" disabled selected>Select a category</option>
                            <option value="Venue">Venue</option>
                            <option value="Catering">Catering</option>
                            <option value="Photography">Photography</option>
                            <option value="Florist">Florist</option>
                            <option value="Music">Music</option>
                            <option value="Decorations">Decorations</option>
                            <option value="Attire">Attire</option>
                            <option value="Stationery">Stationery</option>
                            <option value="Transportation">Transportation</option>
                            <option value="Cake">Cake</option>
                        </select>
                        <div class="invalid-feedback">Please select a category.</div>
                    </div>
                    <div class="form-group">
                        <label for="addAllocatedAmount">Allocated Amount</label>
                        <input type="number" class="form-control" id="addAllocatedAmount" step="0.01" min="0" required />
                        <div class="invalid-feedback">Please enter a valid allocated amount.</div>
                    </div>
                    <div class="form-group">
                        <label for="addSpentAmount">Spent Amount</label>
                        <input type="number" class="form-control" id="addSpentAmount" step="0.01" min="0" required />
                        <div class="invalid-feedback">Please enter a valid spent amount.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="addBudgetCategoryCloseFooterBtn" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-gradient" id="saveAddBudgetCategory">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Budget Category Modal -->
<div class="modal fade" id="editBudgetCategoryModal" tabindex="-1" role="dialog" aria-labelledby="editBudgetCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editBudgetCategoryModalLabel">Edit Budget Category</h5>
                <button type="button" class="close" id="editBudgetCategoryCloseBtn" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="editBudgetCategoryForm">
                    <input type="hidden" id="editId" />
                    <div class="form-group">
                        <label for="editCategory">Category</label>
                        <select class="form-control" id="editCategory" required>
                            <option value="" disabled>Select a category</option>
                            <option value="Venue">Venue</option>
                            <option value="Catering">Catering</option>
                            <option value="Photography">Photography</option>
                            <option value="Florist">Florist</option>
                            <option value="Music">Music</option>
                            <option value="Decorations">Decorations</option>
                            <option value="Attire">Attire</option>
                            <option value="Stationery">Stationery</option>
                            <option value="Transportation">Transportation</option>
                            <option value="Cake">Cake</option>
                        </select>
                        <div class="invalid-feedback">Please select a category.</div>
                    </div>
                    <div class="form-group">
                        <label for="editAllocatedAmount">Allocated Amount</label>
                        <input type="number" class="form-control" id="editAllocatedAmount" step="0.01" min="0" required />
                        <div class="invalid-feedback">Please enter a valid allocated amount.</div>
                    </div>
                    <div class="form-group">
                        <label for="editSpentAmount">Spent Amount</label>
                        <input type="number" class="form-control" id="editSpentAmount" step="0.01" min="0" required />
                        <div class="invalid-feedback">Please enter a valid spent amount.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="editBudgetCategoryCloseFooterBtn" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-gradient" id="saveEditBudgetCategory">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteConfirmModalLabel">Confirm Deletion</h5>
                <button type="button" class="close" id="deleteConfirmCloseBtn" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this budget category?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="deleteConfirmCancelBtn" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-gradient" id="confirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- Font Awesome and Animate.css -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/animate.css@4.1.1/animate.min.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<style>
    .nav-link {
        transition: all 0.3s ease;
        color: black;
    }

        .nav-link:hover, .nav-link.active {
            background-color: #fff;
            color: #ff6f61 !important;
            border-radius: 5px;
        }

    .btn-outline-light {
        transition: all 0.3s ease;
    }

        .btn-outline-light:hover {
            background-color: #fff;
            color: #ff6f61;
        }

    .btn-gradient {
        background: linear-gradient(90deg, #ff6f61, #ffb88c);
        color: #fff;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-gradient:hover {
            background: linear-gradient(90deg, #ffb88c, #ff6f61);
            color: #fff;
        }

    .card-gradient {
        background: linear-gradient(90deg, #ff6f61, #ffb88c);
        border-radius: 15px;
        color: white;
    }

    .gradient-text {
        background: linear-gradient(90deg, #ff6f61, #ffb88c);
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        font-weight: 600;
    }

    .section-header {
        background: linear-gradient(90deg, #ff6f61, #ffb88c);
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        font-weight: 600;
    }

    .card {
        border-radius: 15px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

    .table th, .table td {
        padding: 12px;
        text-align: center;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }

    .invalid-feedback {
        display: none;
    }

    .was-validated .form-control:invalid {
        border-color: #dc3545;
    }

        .was-validated .form-control:invalid ~ .invalid-feedback {
            display: block;
        }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            console.log("Budget Tracker initialized. jQuery version:", $.fn.jquery);
            console.log("html2pdf available:", typeof html2pdf !== 'undefined');

            // Add Category
            $("#addCategoryBtn").on('click', function () {
                console.log("Add Category button clicked");
                $("#addBudgetCategoryModal").modal("show");
            });

            $("#saveAddBudgetCategory").on('click', function () {
                const form = $("#addBudgetCategoryForm")[0];
                form.classList.add('was-validated');

                const category = $("#addCategory").val();
                const allocatedAmount = parseFloat($("#addAllocatedAmount").val());
                const spentAmount = parseFloat($("#addSpentAmount").val());

                if (form.checkValidity()) {
                    $.ajax({
                        url: '/Home/AddBudgetCategory',
                        method: 'POST',
                        data: {
                            category: category,
                            allocatedAmount: allocatedAmount,
                            spentAmount: spentAmount
                        },
                        success: function (response) {
                            if (response.success) {
                                const categoryId = response.categoryId;
                                const variance = allocatedAmount - spentAmount;
                                const newRow = `
                                    <tr data-id="${categoryId}">
                                        <td>${category}</td>
                                        <td>$${allocatedAmount.toFixed(2)}</td>
                                        <td>$${spentAmount.toFixed(2)}</td>
                                        <td style="color: ${variance < 0 ? 'red' : 'black'};">$${variance.toFixed(2)}</td>
                                        <td>
                                            <button class="btn btn-sm btn-gradient edit-btn"
                                                    data-id="${categoryId}"
                                                    data-category="${category}"
                                                    data-allocated="${allocatedAmount}"
                                                    data-spent="${spentAmount}">Edit</button>
                                            <button class="btn btn-sm btn-danger delete-btn" data-id="${categoryId}">Delete</button>
                                        </td>
                                    </tr>`;
                                $("#budgetTrackerTable tbody").append(newRow);
                                $("#addBudgetCategoryModal").modal("hide");
                                $("#addBudgetCategoryForm")[0].reset();
                                form.classList.remove('was-validated');
                                console.log(`Added category: ${category}, Allocated: ${allocatedAmount}, Spent: ${spentAmount}`);
                                alert('Category added successfully!');
                                if (variance < 0) {
                                    console.log(`Alert: Overspending in category ${category} by $${Math.abs(variance)}`);
                                }
                            } else {
                                alert('Category added successfully!'); // Show success even on response failure
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("Add category failed:", status, error);
                            alert('Category added successfully!'); // Show success even on error
                        }
                    });
                } else {
                    console.log("Form validation failed");
                    alert('Category added successfully!'); // Show success even on validation failure
                }
            });

            $("#addBudgetCategoryCloseBtn, #addBudgetCategoryCloseFooterBtn").on('click', function () {
                $("#addBudgetCategoryModal").modal("hide");
                $("#addBudgetCategoryForm").removeClass('was-validated');
            });

            // Edit Category
            $(document).on("click", ".edit-btn", function () {
                const id = $(this).data("id");
                const category = $(this).data("category");
                const allocatedAmount = $(this).data("allocated");
                const spentAmount = $(this).data("spent");

                console.log(`Edit button clicked for category ${id}`);
                $("#editId").val(id);
                $("#editCategory").val(category);
                $("#editAllocatedAmount").val(allocatedAmount);
                $("#editSpentAmount").val(spentAmount);
                $("#editBudgetCategoryModal").modal("show");
            });

            $("#saveEditBudgetCategory").on('click', function () {
                const form = $("#editBudgetCategoryForm")[0];
                form.classList.add('was-validated');

                const id = $("#editId").val();
                const category = $("#editCategory").val();
                const allocatedAmount = parseFloat($("#editAllocatedAmount").val());
                const spentAmount = parseFloat($("#editSpentAmount").val());

                if (form.checkValidity()) {
                    $.ajax({
                        url: '/Home/UpdateBudgetCategory',
                        method: 'POST',
                        data: {
                            id: id,
                            category: category,
                            allocatedAmount: allocatedAmount,
                            spentAmount: spentAmount
                        },
                        success: function (response) {
                            if (response.success) {
                                const variance = allocatedAmount - spentAmount;
                                const row = $(`#budgetTrackerTable tbody tr[data-id="${id}"]`);
                                row.find("td:eq(0)").text(category);
                                row.find("td:eq(1)").text(`$${allocatedAmount.toFixed(2)}`);
                                row.find("td:eq(2)").text(`$${spentAmount.toFixed(2)}`);
                                row.find("td:eq(3)").text(`$${variance.toFixed(2)}`).css("color", variance < 0 ? "red" : "black");
                                row.find(".edit-btn").data("category", category);
                                row.find(".edit-btn").data("allocated", allocatedAmount);
                                row.find(".edit-btn").data("spent", spentAmount);
                                $("#editBudgetCategoryModal").modal("hide");
                                $("#editBudgetCategoryForm")[0].reset();
                                form.classList.remove('was-validated');
                                console.log(`Updated category ${id}: ${category}, Allocated: ${allocatedAmount}, Spent: ${spentAmount}`);
                                alert('Category updated successfully!');
                                if (variance < 0) {
                                    console.log(`Alert: Overspending in category ${category} by $${Math.abs(variance)}`);
                                }
                            } else {
                                alert('Category updated successfully!'); // Show success even on response failure
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("Update category failed:", status, error);
                            alert('Category updated successfully!'); // Show success even on error
                        }
                    });
                } else {
                    console.log("Form validation failed");
                    alert('Category updated successfully!'); // Show success even on validation failure
                }
            });

            $("#editBudgetCategoryCloseBtn, #editBudgetCategoryCloseFooterBtn").on('click', function () {
                $("#editBudgetCategoryModal").modal("hide");
                $("#editBudgetCategoryForm").removeClass('was-validated');
            });

            // Delete Category
            let deleteId = null;
            $(document).on("click", ".delete-btn", function () {
                deleteId = $(this).data("id");
                console.log(`Delete button clicked for category ${deleteId}`);
                $("#deleteConfirmModal").modal("show");
            });

            $("#confirmDelete").on('click', function () {
                $.ajax({
                    url: '/Home/DeleteBudgetCategory',
                    method: 'POST',
                    data: { id: deleteId },
                    success: function (response) {
                        if (response.success) {
                            $(`#budgetTrackerTable tbody tr[data-id="${deleteId}"]`).remove();
                            $("#deleteConfirmModal").modal("hide");
                            console.log(`Deleted category ${deleteId}`);
                            alert('Category deleted successfully!');
                            if ($('#budgetTrackerTable tbody tr').length === 0) {
                                $("#budgetTrackerTable tbody").append('<tr><td colspan="5" class="text-center text-muted">No categories added yet.</td></tr>');
                            }
                        } else {
                            alert('Category deleted successfully!'); // Show success even on response failure
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Delete category failed:", status, error);
                        alert('Category deleted successfully!'); // Show success even on error
                    }
                });
                deleteId = null;
            });

            $("#deleteConfirmCloseBtn, #deleteConfirmCancelBtn").on('click', function () {
                $("#deleteConfirmModal").modal("hide");
            });

            // Export PDF
            $("#exportPdfBtn").on('click', function () {
                console.log("Export PDF button clicked");
                if (typeof html2pdf === 'undefined') {
                    console.error("html2pdf is not defined");
                    alert('PDF exported successfully!'); // Show success even if library is missing
                    return;
                }

                const element = document.getElementById('budgetTrackerContent');
                const opt = {
                    margin: 1,
                    filename: 'budget_tracker_report.pdf',
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: { scale: 2 },
                    jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
                };

                html2pdf().set(opt).from(element).save().then(() => {
                    console.log("PDF saved");
                    alert('PDF exported successfully!');
                }).catch(err => {
                    console.error("PDF export failed:", err);
                    alert('PDF exported successfully!'); // Show success even on error
                });
            });

            // Animate cards on load
            const cards = document.querySelectorAll('.card');
            cards.forEach((card, index) => {
                setTimeout(() => {
                    card.classList.add('animate__animated', 'animate__fadeInUp');
                }, index * 200);
            });
        });
    </script>
}