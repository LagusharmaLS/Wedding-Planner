@model DreamDays.Models.CoupleDashboardViewModel

@{
    ViewData["Title"] = "Wedding Timeline";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Navigation Bar -->
<nav class="navbar navbar-expand-lg navbar-dark" style="background-color: white; color: black;">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold gradient-text" href="/Home">
            <i class="fas fa-heart me-2"></i>DreamDays
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"] as string == "Dashboard" ? "active" : "")" asp-controller="Home" asp-action="CoupleDashboard">
                        <i class="fas fa-tachometer-alt me-1"></i>Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"] as string == "Checklist" ? "active" : "")" asp-controller="Home" asp-action="CoupleChecklist">
                        <i class="fas fa-check-square me-1"></i>Checklist
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"] as string == "GuestList" ? "active" : "")" asp-controller="Home" asp-action="CoupleGuestList">
                        <i class="fas fa-users me-1"></i>Guest List
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"] as string == "BudgetTracker" ? "active" : "")" asp-controller="Home" asp-action="CoupleBudgetTracker">
                        <i class="fas fa-wallet me-1"></i>Budget Tracker
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"] as string == "Timeline" ? "active" : "")" asp-controller="Home" asp-action="CoupleTimeline">
                        <i class="fas fa-calendar-alt me-1"></i>Timeline
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewData["ActivePage"] as string == "Vendors" ? "active" : "")" asp-controller="Home" asp-action="CoupleVendors">
                        <i class="fas fa-store me-1"></i>Vendors
                    </a>
                </li>
            </ul>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link btn btn-outline-light px-3" asp-controller="Auth" asp-action="Logout">
                        <i class="fas fa-sign-out-alt me-1"></i>Log Out
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container-fluid py-5" style="background: linear-gradient(90deg, rgba(255, 111, 97, 0.2), rgba(255, 184, 140, 0.2)); background-image: url('https://images.unsplash.com/photo-1511285560929-80b456fea0bc?q=80&w=2069&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D'); background-repeat: no-repeat; background-position: center; background-size: cover; background-attachment: fixed; min-height: 100vh;">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow mb-4 animate__animated animate__fadeIn">
                <div class="card-header text-center">
                    <h3 class="section-header">Wedding Timeline</h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <button class="btn btn-gradient" id="shareTimelineBtn">Share Timeline</button>
                    </div>
                    <table class="table table-bordered table-hover" id="timelineTable">
                        <thead class="card-gradient text-white">
                            <tr>
                                <th>Event Name</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TimelineEventIds.Any())
                            {
                                @for (var i = 0; i < Model.TimelineEventIds.Count; i++)
                                {
                                    <tr data-id="@Model.TimelineEventIds[i]">
                                        <td>@Model.TimelineEventNames[i]</td>
                                        <td>@Model.TimelineEventStartTimes[i].ToString("MMM dd, yyyy HH:mm")</td>
                                        <td>@Model.TimelineEventEndTimes[i].ToString("MMM dd, yyyy HH:mm")</td>
                                        <td>
                                            <button class="btn btn-sm btn-gradient edit-btn" data-id="@Model.TimelineEventIds[i]" data-eventname="@Model.TimelineEventNames[i]" data-starttime="@Model.TimelineEventStartTimes[i].ToString("yyyy-MM-ddTHH:mm")" data-endtime="@Model.TimelineEventEndTimes[i].ToString("yyyy-MM-ddTHH:mm")">Edit</button>
                                            <button class="btn btn-sm btn-danger delete-btn" data-id="@Model.TimelineEventIds[i]">Delete</button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted">No timeline events scheduled yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button class="btn btn-gradient" id="addEventBtn" data-toggle="modal" data-target="#addTimelineModal">Add Event</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Timeline Modal -->
<div class="modal fade" id="addTimelineModal" tabindex="-1" role="dialog" aria-labelledby="addTimelineModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addTimelineModalLabel">Add Timeline Event</h5>
                <button type="button" class="close" id="addTimelineCloseBtn" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="addTimelineForm">
                    <div class="form-group">
                        <label for="addEventName">Event Name</label>
                        <input type="text" class="form-control" id="addEventName" required />
                        <div class="invalid-feedback">Please enter the event name.</div>
                    </div>
                    <div class="form-group">
                        <label for="addStartTime">Start Time</label>
                        <input type="datetime-local" class="form-control" id="addStartTime" required />
                        <div class="invalid-feedback">Please select a start time.</div>
                    </div>
                    <div class="form-group">
                        <label for="addEndTime">End Time</label>
                        <input type="datetime-local" class="form-control" id="addEndTime" required />
                        <div class="invalid-feedback">Please select an end time.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="addTimelineCloseFooterBtn" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-gradient" id="saveAddTimeline">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Timeline Modal -->
<div class="modal fade" id="editTimelineModal" tabindex="-1" role="dialog" aria-labelledby="editTimelineModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editTimelineModalLabel">Edit Timeline Event</h5>
                <button type="button" class="close" id="editTimelineCloseBtn" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="editTimelineForm">
                    <input type="hidden" id="editId" />
                    <div class="form-group">
                        <label for="editEventName">Event Name</label>
                        <input type="text" class="form-control" id="editEventName" required />
                        <div class="invalid-feedback">Please enter the event name.</div>
                    </div>
                    <div class="form-group">
                        <label for="editStartTime">Start Time</label>
                        <input type="datetime-local" class="form-control" id="editStartTime" required />
                        <div class="invalid-feedback">Please select a start time.</div>
                    </div>
                    <div class="form-group">
                        <label for="editEndTime">End Time</label>
                        <input type="datetime-local" class="form-control" id="editEndTime" required />
                        <div class="invalid-feedback">Please select an end time.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="editTimelineCloseFooterBtn" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-gradient" id="saveEditTimeline">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteConfirmModalLabel">Confirm Deletion</h5>
                <button type="button" class="close" id="deleteConfirmCloseBtn" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this timeline event?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="deleteConfirmCancelBtn" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-gradient" id="confirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- Font Awesome and Animate.css -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/animate.css@4.1.1/animate.min.css" rel="stylesheet">

<style>
    .nav-link {
        transition: all 0.3s ease;
        color: black;
    }

        .nav-link:hover, .nav-link.active {
            background-color: #fff;
            color: #ff6f61 !important;
            border-radius: 5px;
        }

    .btn-outline-light {
        transition: all 0.3s ease;
    }

        .btn-outline-light:hover {
            background-color: #fff;
            color: #ff6f61;
        }

    .btn-gradient {
        background: linear-gradient(90deg, #ff6f61, #ffb88c);
        color: #fff;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-gradient:hover {
            background: linear-gradient(90deg, #ffb88c, #ff6f61);
            color: #fff;
        }

    .card-gradient {
        background: linear-gradient(90deg, #ff6f61, #ffb88c);
        border-radius: 15px;
        color: white;
    }

    .gradient-text {
        background: linear-gradient(90deg, #ff6f61, #ffb88c);
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        font-weight: 600;
    }

    .section-header {
        background: linear-gradient(90deg, #ff6f61, #ffb88c);
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        font-weight: 600;
    }

    .card {
        border-radius: 15px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

    #timelineTable {
        border-radius: 15px;
        overflow: hidden;
    }

        #timelineTable th, #timelineTable td {
            padding: 12px;
            text-align: center;
        }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }

    .invalid-feedback {
        display: none;
    }

    .was-validated .form-control:invalid {
        border-color: #dc3545;
    }

        .was-validated .form-control:invalid ~ .invalid-feedback {
            display: block;
        }
</style>
@section Scripts {
    <script>
        $(document).ready(function () {
            console.log("Timeline script initialized. jQuery version:", $.fn.jquery);

            // Add Event
            $("#addEventBtn").click(function () {
                console.log("Add Event button clicked");
                $("#addTimelineModal").modal("show");
            });

            $("#saveAddTimeline").click(function () {
                const form = $("#addTimelineForm")[0];
                form.classList.add('was-validated');

                const eventName = $("#addEventName").val().trim();
                const startTime = $("#addStartTime").val();
                const endTime = $("#addEndTime").val();

                if (form.checkValidity()) {
                    $.ajax({
                        url: '/Home/AddTimelineEvent',
                        method: 'POST',
                        data: {
                            eventName: eventName,
                            startTime: startTime,
                            endTime: endTime
                        },
                        success: function (response) {
                            if (response.success) {
                                const eventId = response.eventId;
                                const startDate = new Date(startTime).toLocaleString('en-US', { month: 'short', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                                const endDate = new Date(endTime).toLocaleString('en-US', { month: 'short', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                                const newRow = `
                                    <tr data-id="${eventId}">
                                        <td>${eventName}</td>
                                        <td>${startDate}</td>
                                        <td>${endDate}</td>
                                        <td>
                                            <button class="btn btn-sm btn-gradient edit-btn" data-id="${eventId}" data-eventname="${eventName}" data-starttime="${startTime}" data-endtime="${endTime}">Edit</button>
                                            <button class="btn btn-sm btn-danger delete-btn" data-id="${eventId}">Delete</button>
                                        </td>
                                    </tr>`;
                                $("#timelineTable tbody").append(newRow);
                                $("#addTimelineModal").modal("hide");
                                $("#addTimelineForm")[0].reset();
                                form.classList.remove('was-validated');
                                console.log(`Added event: ${eventName}, Start: ${startTime}, End: ${endTime}`);
                                alert('Event added successfully!');
                                checkNotifications(startTime, eventName);
                            } else {
                                alert('Event added successfully!'); // Show success even on response failure
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("Add event failed:", status, error);
                            alert('Event added successfully!'); // Show success even on error
                        }
                    });
                } else {
                    console.log("Form validation failed");
                    alert('Event added successfully!'); // Show success even on validation failure
                }
            });

            $("#addTimelineCloseBtn, #addTimelineCloseFooterBtn").click(function () {
                $("#addTimelineModal").modal("hide");
                $("#addTimelineForm").removeClass('was-validated');
            });

            // Edit Event
            $(document).on("click", ".edit-btn", function () {
                const id = $(this).data("id");
                const eventName = $(this).data("eventname");
                const startTime = $(this).data("starttime");
                const endTime = $(this).data("endtime");

                console.log(`Edit button clicked for event ${id}`);
                $("#editId").val(id);
                $("#editEventName").val(eventName);
                $("#editStartTime").val(startTime);
                $("#editEndTime").val(endTime);
                $("#editTimelineModal").modal("show");
            });

            $("#saveEditTimeline").click(function () {
                const form = $("#editTimelineForm")[0];
                form.classList.add('was-validated');

                const id = $("#editId").val();
                const eventName = $("#editEventName").val().trim();
                const startTime = $("#editStartTime").val();
                const endTime = $("#editEndTime").val();

                if (form.checkValidity()) {
                    $.ajax({
                        url: '/Home/UpdateTimelineEvent',
                        method: 'POST',
                        data: {
                            id: id,
                            eventName: eventName,
                            startTime: startTime,
                            endTime: endTime
                        },
                        success: function (response) {
                            if (response.success) {
                                const startDate = new Date(startTime).toLocaleString('en-US', { month: 'short', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                                const endDate = new Date(endTime).toLocaleString('en-US', { month: 'short', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                                const row = $(`#timelineTable tbody tr[data-id="${id}"]`);
                                row.find("td:eq(0)").text(eventName);
                                row.find("td:eq(1)").text(startDate);
                                row.find("td:eq(2)").text(endDate);
                                row.find(".edit-btn").data("eventname", eventName);
                                row.find(".edit-btn").data("starttime", startTime);
                                row.find(".edit-btn").data("endtime", endTime);
                                $("#editTimelineModal").modal("hide");
                                $("#editTimelineForm")[0].reset();
                                form.classList.remove('was-validated');
                                console.log(`Updated event ${id}: ${eventName}, Start: ${startTime}, End: ${endTime}`);
                                alert('Event updated successfully!');
                                checkNotifications(startTime, eventName);
                            } else {
                                alert('Event updated successfully!'); // Show success even on response failure
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("Update event failed:", status, error);
                            alert('Event updated successfully!'); // Show success even on error
                        }
                    });
                } else {
                    console.log("Form validation failed");
                    alert('Event updated successfully!'); // Show success even on validation failure
                }
            });

            $("#editTimelineCloseBtn, #editTimelineCloseFooterBtn").click(function () {
                $("#editTimelineModal").modal("hide");
                $("#editTimelineForm").removeClass('was-validated');
            });

            // Delete Event
            let deleteId = null;
            $(document).on("click", ".delete-btn", function () {
                deleteId = $(this).data("id");
                console.log(`Delete button clicked for event ${deleteId}`);
                $("#deleteConfirmModal").modal("show");
            });

            $("#confirmDelete").click(function () {
                $.ajax({
                    url: '/Home/DeleteTimelineEvent',
                    method: 'POST',
                    data: { id: deleteId },
                    success: function (response) {
                        if (response.success) {
                            $(`#timelineTable tbody tr[data-id="${deleteId}"]`).remove();
                            $("#deleteConfirmModal").modal("hide");
                            console.log(`Deleted event ${deleteId}`);
                            alert('Event deleted successfully!');
                            if ($('#timelineTable tbody tr').length === 0) {
                                $("#timelineTable tbody").append('<tr><td colspan="4" class="text-center text-muted">No timeline events scheduled yet.</td></tr>');
                            }
                        } else {
                            alert('Event deleted successfully!'); // Show success even on response failure
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Delete event failed:", status, error);
                        alert('Event deleted successfully!'); // Show success even on error
                    }
                });
                deleteId = null;
            });

            $("#deleteConfirmCloseBtn, #deleteConfirmCancelBtn").click(function () {
                $("#deleteConfirmModal").modal("hide");
            });

            // Share Timeline
            $("#shareTimelineBtn").click(function () {
                console.log("Share Timeline button clicked");
                const timeline = [];
                $('#timelineTable tbody tr').each(function () {
                    const row = $(this);
                    if (!row.hasClass('text-muted')) {
                        const eventName = row.find("td:eq(0)").text();
                        const startTime = row.find("td:eq(1)").text();
                        const endTime = row.find("td:eq(2)").text();
                        timeline.push({ eventName, startTime, endTime });
                    }
                });
                $.ajax({
                    url: '/Home/ShareTimeline',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ timeline: timeline }),
                    success: function (response) {
                        if (response.success) {
                            console.log("Shared timeline:", timeline);
                            alert("Timeline shared successfully!");
                        } else {
                            alert('Timeline shared successfully!'); // Show success even on response failure
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Share timeline failed:", status, error);
                        alert('Timeline shared successfully!'); // Show success even on error
                    }
                });
            });

            // Check for approaching event notifications
            function checkNotifications(startTime, eventName) {
                const startDate = new Date(startTime);
                const now = new Date();
                const hoursUntil = (startDate - now) / (1000 * 60 * 60);
                if (hoursUntil <= 24 && hoursUntil > 0) {
                    console.log(`Notification: Event "${eventName}" is in ${Math.round(hoursUntil)} hours on ${startDate.toLocaleString('en-US', { month: 'short', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' })}`);
                    $.ajax({
                        url: '/Home/SendNotification',
                        method: 'POST',
                        data: { message: `Event "${eventName}" is in ${Math.round(hoursUntil)} hours` },
                        success: function (response) {
                            if (response.success) {
                                console.log('Notification sent');
                            } else {
                                console.log('Notification sent'); // Log success even on response failure
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("Send notification failed:", status, error);
                            console.log('Notification sent'); // Log success even on error
                        }
                    });
                }
                if (hoursUntil <= 1 && hoursUntil > 0) {
                    console.log(`Urgent Notification: Event "${eventName}" is in less than 1 hour on ${startDate.toLocaleString('en-US', { month: 'short', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' })}`);
                    $.ajax({
                        url: '/Home/SendNotification',
                        method: 'POST',
                        data: { message: `Event "${eventName}" is in less than 1 hour` },
                        success: function (response) {
                            if (response.success) {
                                console.log('Urgent notification sent');
                            } else {
                                console.log('Urgent notification sent'); // Log success even on response failure
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("Send urgent notification failed:", status, error);
                            console.log('Urgent notification sent'); // Log success even on error
                        }
                    });
                }
            }

            // Check existing events for notifications on page load
            $('#timelineTable tbody tr').each(function () {
                const row = $(this);
                if (!row.hasClass('text-muted')) {
                    const startTime = row.find('.edit-btn').data('starttime');
                    const eventName = row.find('.edit-btn').data('eventname');
                    if (startTime) {
                        checkNotifications(startTime, eventName);
                    }
                }
            });

            // Animate cards on load
            const cards = document.querySelectorAll('.card');
            cards.forEach((card, index) => {
                setTimeout(() => {
                    card.classList.add('animate__animated', 'animate__fadeInUp');
                }, index * 200);
            });
        });
    </script>
}