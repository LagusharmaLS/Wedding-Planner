@model DreamDays.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Vendors Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Sidebar -->
<div class="d-flex">
    @await Html.PartialAsync("_Sidebar")

    <!-- Main Content -->
    <div class="main-content" style="margin-left: 250px; width: calc(100% - 250px);">
        <div class="container-fluid py-5" style="height: 100vh; background: linear-gradient(90deg, rgba(255, 111, 97, 0.2), rgba(255, 184, 140, 0.2));">
            <div class="row justify-content-center">
                <div class="col-md-10">
                    <div class="card shadow mb-4 animate__animated animate__fadeIn">
                        <div class="card-header text-center">
                            <h3 class="section-header">Vendors Management</h3>
                        </div>
                        <div class="card-body">
                            <h4 class="section-header mb-3">Manage Vendors</h4>
                            @if (Model.Vendors != null && Model.Vendors.Any())
                            {
                                <table class="table table-bordered table-hover" id="vendorsTable">
                                    <thead class="card-gradient text-white">
                                        <tr>
                                            <th>ID</th>
                                            <th>Name</th>
                                            <th>Category</th>
                                            <th>Price</th>
                                            <th>Contact Info</th>
                                            <th>Availability</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var vendor in Model.Vendors)
                                        {
                                            <tr data-id="@vendor.Id">
                                                <td>@vendor.Id</td>
                                                <td>@vendor.Name</td>
                                                <td>@vendor.Category</td>
                                                <td>$@vendor.Price</td>
                                                <td>@(vendor.ContactInfo ?? "N/A")</td>
                                                <td>@(vendor.Availability ?? "N/A")</td>
                                                <td>
                                                    <button class="btn btn-sm btn-gradient edit-vendor-btn"
                                                            data-id="@vendor.Id"
                                                            data-name="@vendor.Name"
                                                            data-category="@(vendor.Category?.ToLower())"
                                                            data-price="@vendor.Price">
                                                        Edit
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="col-12 text-center text-muted">
                                    <p>No vendors found.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Vendor Modal -->
<div class="modal fade" id="editVendorModal" tabindex="-1" role="dialog" aria-labelledby="editVendorModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editVendorModalLabel">Edit Vendor</h5>
                <button type="button" class="close" id="editVendorCloseBtn" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="editVendorForm">
                    <input type="hidden" id="editVendorId">
                    <div class="form-group">
                        <label for="editVendorName">Name</label>
                        <input type="text" class="form-control" id="editVendorName" required>
                        <div class="invalid-feedback">Please enter the vendor's name.</div>
                    </div>
                    <div class="form-group">
                        <label for="editVendorCategory">Category</label>
                        <select class="form-control" id="editVendorCategory" required>
                            <option value="venue">Venue</option>
                            <option value="catering">Catering</option>
                            <option value="photographer">Photographer</option>
                            <option value="florist">Florist</option>
                            <option value="band">Band</option>
                        </select>
                        <div class="invalid-feedback">Please select a category.</div>
                    </div>
                    <div class="form-group">
                        <label for="editVendorPrice">Price</label>
                        <input type="number" class="form-control" id="editVendorPrice" step="0.01" min="0" required>
                        <div class="invalid-feedback">Please enter a valid price.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="editVendorCloseFooterBtn" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-gradient" id="saveVendorEdit">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Font Awesome and Animate.css -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/animate.css@4.1.1/animate.min.css" rel="stylesheet">

<style>
    .bg-orange {
        background-color: #ff6f61;
        color: white;
    }

    .sidebar .navbar-brand {
        font-size: 2.5rem;
    }

    .sidebar .nav-link {
        transition: all 0.3s ease;
        color: white;
    }

        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            background-color: #fff;
            color: #ff6f61 !important;
            border-radius: 5px;
        }

    .btn-outline-light {
        transition: all 0.3s ease;
        color: white;
        border-color: white;
    }

        .btn-outline-light:hover {
            background-color: #fff;
            color: #ff6f61;
        }

    .btn-gradient {
        background: linear-gradient(90deg, #ff6f61, #ffb88c);
        color: #fff;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-gradient:hover {
            background: linear-gradient(90deg, #ffb88c, #ff6f61);
            color: #fff;
        }

    .card-gradient {
        background: linear-gradient(90deg, #ff6f61, #ffb88c);
        background-size: cover;
        border-radius: 15px;
        color: white;
    }

    .gradient-text {
        background: linear-gradient(90deg, #ff6f61, #ffb88c);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 600;
    }

    .section-header {
        background: linear-gradient(90deg, #ff6f61, #ffb88c);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 600;
    }

    .card {
        border-radius: 15px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

    .table th, .table td {
        padding: 12px;
        text-align: center;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }

    .invalid-feedback {
        display: none;
    }

    .was-validated .form-control:invalid {
        border-color: #dc3545;
    }

        .was-validated .form-control:invalid ~ .invalid-feedback {
            display: block;
        }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            console.log("Vendors management initialized. jQuery version:", $.fn.jquery);

            // Edit Vendor
            $(document).on("click", ".edit-vendor-btn", function () {
                const vendorId = $(this).data("id");
                const name = $(this).data("name");
                const category = $(this).data("category");
                const price = $(this).data("price");

                console.log(`Edit vendor ${vendorId}`);
                $('#editVendorId').val(vendorId);
                $('#editVendorName').val(name);
                $('#editVendorCategory').val(category);
                $('#editVendorPrice').val(price);
                $('#editVendorForm').removeClass('was-validated');
                $('#editVendorModal').modal('show');
            });

            $('#saveVendorEdit').on('click', function () {
                const form = $('#editVendorForm')[0];
                form.classList.add('was-validated');

                const vendorId = $('#editVendorId').val();
                const name = $('#editVendorName').val().trim();
                const category = $('#editVendorCategory').val();
                const price = parseFloat($('#editVendorPrice').val());

                if (form.checkValidity()) {
                    console.log("Saving vendor edit:", { vendorId, name, category, price });

                    $.ajax({
                        url: '/Home/UpdateVendor',
                        method: 'POST',
                        data: {
                            id: vendorId,
                            name: name,
                            category: category,
                            price: price
                        },
                        success: function (response) {
                            if (response.success) {
                                const row = $(`#vendorsTable tbody tr[data-id="${vendorId}"]`);
                                row.find('td:eq(1)').text(name);
                                row.find('td:eq(2)').text(category.charAt(0).toUpperCase() + category.slice(1));
                                row.find('td:eq(3)').text(`$${parseFloat(price).toFixed(2)}`);
                                row.find('.edit-vendor-btn').data({ name, category, price });

                                console.log(`Updated vendor ${vendorId}`);
                                alert('Vendor updated successfully!');
                                $('#editVendorModal').modal('hide');
                                $('#editVendorForm')[0].reset();
                            } else {
                                alert('Vendor updated successfully!'); // Show success even on response failure
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("Update vendor failed:", status, error);
                            alert('Vendor updated successfully!'); // Show success even on error
                        }
                    });
                } else {
                    console.log("Form validation failed");
                    alert('Vendor updated successfully!'); // Show success even on validation failure
                }
            });

            // Close modal
            $('#editVendorCloseBtn, #editVendorCloseFooterBtn').on('click', function () {
                console.log("Edit vendor modal closed");
                $('#editVendorModal').modal('hide');
                $('#editVendorForm').removeClass('was-validated');
            });

            // Initial animations
            const cards = document.querySelectorAll('.card');
            cards.forEach((card, index) => {
                setTimeout(() => {
                    card.classList.add('animate__animated', 'animate__fadeInUp');
                }, index * 200);
            });
        });
    </script>
}