            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="editWeddingCloseFooterBtn" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-gradient" id="saveWeddingEdit">Save Changes</button>
            </div>
        </div>
    </div>
</div>

