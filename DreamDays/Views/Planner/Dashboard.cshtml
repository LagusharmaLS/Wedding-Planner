@model DreamDays.Models.CoupleDashboardViewModel

@{
    ViewData["Title"] = "Planner Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Sidebar -->
<div class="d-flex">
    @await Html.PartialAsync("_PlannerSidebar")

    <!-- Main Content -->
    <div class="main-content" style="margin-left: 250px; width: calc(100% - 250px);">
        <div class="container-fluid py-5" style="min-height: 100vh; background-color: #FFFFFF;">
            <div class="row justify-content-center">
                <div class="col-md-10">
                    <div class="card shadow mb-4 animate__animated animate__fadeIn">
                        <div class="card-header text-center">
                            <h3 class="section-header">Planner Dashboard</h3>
                        </div>
                        <div class="card-body">
                            <!-- Assigned Weddings -->
                            <h4 class="section-header mb-3">Assigned Weddings</h4>
                            <div class="row mb-3">
                                <div class="col-md-12 text-right">
                                    <button class="btn btn-gradient" id="addWeddingBtn" data-toggle="modal" data-target="#addWeddingModal">Add Wedding</button>
                                </div>
                            </div>
                            @if (Model.WeddingIds != null && Model.WeddingIds.Any())
                            {
                                <table class="table table-bordered table-hover" id="weddingsTable">
                                    <thead class="card-gradient text-white">
                                        <tr>
                                            <th>ID</th>
                                            <th>Couple Name</th>
                                            <th>Date</th>
                                            <th>Location</th>
                                            <th>Budget</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.WeddingIds.Count; i++)
                                        {
                                            <tr data-id="@Model.WeddingIds[i]">
                                                <td>@Model.WeddingIds[i]</td>
                                                <td>@(Model.WeddingCoupleNames[i] ?? "N/A")</td>
                                                <td>@Model.WeddingDates[i].ToString("yyyy-MM-dd")</td>
                                                <td>@(Model.WeddingLocations[i] ?? "N/A")</td>
                                                <td>$@Model.WeddingBudgets[i]</td>
                                                <td>@(Model.WeddingStatuses[i] ?? "N/A")</td>
                                                <td>
                                                    <button class="btn btn-sm btn-gradient edit-wedding-btn"
                                                            data-id="@Model.WeddingIds[i]"
                                                            data-couplename="@(Model.WeddingCoupleNames[i] ?? "")"
                                                            data-date="@Model.WeddingDates[i].ToString("yyyy-MM-dd")"
                                                            data-location="@(Model.WeddingLocations[i] ?? "")"
                                                            data-budget="@Model.WeddingBudgets[i]"
                                                            data-status="@(Model.WeddingStatuses[i] ?? "")">
                                                        Edit
                                                    </button>
                                                    <button class="btn btn-sm btn-danger delete-wedding-btn" data-id="@Model.WeddingIds[i]">Delete</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="col-12 text-center text-muted">
                                    <p>No weddings assigned.</p>
                                </div>
                            }

                            <!-- Checklist Items -->
                            <h4 class="section-header mb-3 mt-4">Checklist Items</h4>
                            <div class="row mb-3">
                                <div class="col-md-12 text-right">
                                    <button class="btn btn-gradient" id="addChecklistBtn" data-toggle="modal" data-target="#addChecklistModal">Add Checklist Item</button>
                                </div>
                            </div>
                            @if (Model.ChecklistIds != null && Model.ChecklistIds.Any())
                            {
                                <table class="table table-bordered table-hover" id="checklistTable">
                                    <thead class="card-gradient text-white">
                                        <tr>
                                            <th>ID</th>
                                            <th>Description</th>
                                            <th>Deadline</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.ChecklistIds.Count; i++)
                                        {
                                            <tr data-id="@Model.ChecklistIds[i]">
                                                <td>@Model.ChecklistIds[i]</td>
                                                <td>@(Model.ChecklistDescriptions[i] ?? "N/A")</td>
                                                <td>@Model.ChecklistDeadlines[i].ToString("yyyy-MM-dd")</td>
                                                <td>@(Model.ChecklistIsCompleted[i] ? "Completed" : "Pending")</td>
                                                <td>
                                                    <button class="btn btn-sm btn-gradient edit-checklist-btn"
                                                            data-id="@Model.ChecklistIds[i]"
                                                            data-description="@(Model.ChecklistDescriptions[i] ?? "")"
                                                            data-deadline="@Model.ChecklistDeadlines[i].ToString("yyyy-MM-dd")"
                                                            data-iscompleted="@Model.ChecklistIsCompleted[i].ToString().ToLower()">
                                                        Edit
                                                    </button>
                                                    <button class="btn btn-sm btn-danger delete-checklist-btn" data-id="@Model.ChecklistIds[i]">Delete</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="col-12 text-center text-muted">
                                    <p>No checklist items available.</p>
                                </div>
                            }

                            <!-- Vendors -->
                            <h4 class="section-header mb-3 mt-4">Vendors</h4>
                            <div class="row mb-3">
                                <div class="col-md-12 text-right">
                                    <button class="btn btn-gradient" id="filterAvailableVendorsBtn">Show Available Vendors</button>
                                </div>
                            </div>
                            @if (Model.Vendors != null && Model.Vendors.Any())
                            {
                                <table class="table table-bordered table-hover" id="vendorsTable">
                                    <thead class="card-gradient text-white">
                                        <tr>
                                            <th>ID</th>
                                            <th>Name</th>
                                            <th>Category</th>
                                            <th>Price</th>
                                            <th>Contact Info</th>
                                            <th>Availability</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var vendor in Model.Vendors)
                                        {
                                            <tr data-id="@vendor.Id" data-availability="@(vendor.Availability?.ToLower() ?? "N/A")">
                                                <td>@vendor.Id</td>
                                                <td>@(vendor.Name ?? "N/A")</td>
                                                <td>@(vendor.Category ?? "N/A")</td>
                                                <td>$@vendor.Price</td>
                                                <td>@(vendor.ContactInfo ?? "N/A")</td>
                                                <td>@(vendor.Availability ?? "N/A")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="col-12 text-center text-muted">
                                    <p>No vendors available.</p>
                                </div>
                            }

                            <!-- Messages Section -->
                            <h4 class="section-header mb-3 mt-4">Messages</h4>
                            <div class="row mb-3">
                                <div class="col-md-12 text-right">
                                    <button class="btn btn-gradient" id="sendMessageBtn" data-toggle="modal" data-target="#sendMessageModal">Send Message</button>
                                </div>
                            </div>
                            @if (Model.MessageIds != null && Model.MessageIds.Any())
                            {
                                <table class="table table-bordered table-hover" id="messagesTable">
                                    <thead class="card-gradient text-white">
                                        <tr>
                                            <th>ID</th>
                                            <th>Sender</th>
                                            <th>Receiver</th>
                                            <th>Content</th>
                                            <th>Timestamp</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.MessageIds.Count; i++)
                                        {
                                            <tr data-id="@Model.MessageIds[i]">
                                                <td>@Model.MessageIds[i]</td>
                                                <td>@(Model.MessageSenders[i] ?? "N/A")</td>
                                                <td>@(Model.MessageReceivers[i] ?? "N/A")</td>
                                                <td>@(Model.MessageContents[i] ?? "N/A")</td>
                                                <td>@Model.MessageTimestamps[i].ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>@(Model.MessageIsRead[i] ? "Read" : "Unread")</td>
                                                <td>
                                                    <button class="btn btn-sm btn-gradient mark-read-btn" data-id="@Model.MessageIds[i]" data-isread="@Model.MessageIsRead[i].ToString().ToLower()">Mark as @(Model.MessageIsRead[i] ? "Unread" : "Read")</button>
                                                    <button class="btn btn-sm btn-danger delete-message-btn" data-id="@Model.MessageIds[i]">Delete</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="col-12 text-center text-muted">
                                    <p>No messages available.</p>
                                </div>
                            }

                            <!-- Logistics Section -->
                            <h4 class="section-header mb-3 mt-4">Logistics</h4>
                            <div class="row mb-3">
                                <div class="col-md-12 text-right">
                                    <button class="btn btn-gradient" id="addLogisticsBtn" data-toggle="modal" data-target="#addLogisticsModal">Add Logistics Task</button>
                                </div>
                            </div>
                            @if (Model.LogisticsTaskIds != null && Model.LogisticsTaskIds.Any())
                            {
                                <table class="table table-bordered table-hover" id="logisticsTable">
                                    <thead class="card-gradient text-white">
                                        <tr>
                                            <th>ID</th>
                                            <th>Type</th>
                                            <th>Description</th>
                                            <th>Scheduled Time</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.LogisticsTaskIds.Count; i++)
                                        {
                                            <tr data-id="@Model.LogisticsTaskIds[i]">
                                                <td>@Model.LogisticsTaskIds[i]</td>
                                                <td>@(Model.LogisticsTaskTypes[i] ?? "N/A")</td>
                                                <td>@(Model.LogisticsTaskDescriptions[i] ?? "N/A")</td>
                                                <td>@Model.LogisticsTaskScheduledTimes[i].ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>@(Model.LogisticsTaskStatuses[i] ?? "N/A")</td>
                                                <td>
                                                    <button class="btn btn-sm btn-gradient edit-logistics-btn"
                                                            data-id="@Model.LogisticsTaskIds[i]"
                                                            data-tasktype="@(Model.LogisticsTaskTypes[i] ?? "")"
                                                            data-description="@(Model.LogisticsTaskDescriptions[i] ?? "")"
                                                            data-scheduledtime="@Model.LogisticsTaskScheduledTimes[i].ToString("yyyy-MM-ddTHH:mm")"
                                                            data-status="@(Model.LogisticsTaskStatuses[i] ?? "")">
                                                        Edit
                                                    </button>
                                                    <button class="btn btn-sm btn-danger delete-logistics-btn" data-id="@Model.LogisticsTaskIds[i]">Delete</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="col-12 text-center text-muted">
                                    <p>No logistics tasks available.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Wedding Modal -->
<div class="modal fade" id="addWeddingModal" tabindex="-1" role="dialog" aria-labelledby="addWeddingModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addWeddingModalLabel">Add Wedding</h5>
                <button type="button" class="close" id="addWeddingCloseBtn" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="addWeddingForm">
                    <div class="form-group">
                        <label for="addCoupleName">Couple Name</label>
                        <input type="text" class="form-control" id="addCoupleName" required>
                        <div class="invalid-feedback">Please enter the couple's name.</div>
                    </div>
                    <div class="form-group">
                        <label for="addWeddingDate">Date</label>
                        <input type="date" class="form-control" id="addWeddingDate" required>
                        <div class="invalid-feedback">Please select a date.</div>
                    </div>
                    <div class="form-group">
                        <label for="addWeddingLocation">Location</label>
                        <input type="text" class="form-control" id="addWeddingLocation" required>
                        <div class="invalid-feedback">Please enter the location.</div>
                    </div>
                    <div class="form-group">
                        <label for="addWeddingBudget">Budget</label>
                        <input type="number" class="form-control" id="addWeddingBudget" step="0.01" min="0" required>
                        <div class="invalid-feedback">Please enter a valid budget.</div>
                    </div>
                    <div class="form-group">
                        <label for="addWeddingStatus">Status</label>
                        <select class="form-control" id="addWeddingStatus" required>
                            <option value="Planning">Planning</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                        <div class="invalid-feedback">Please select a status.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="addWeddingCloseFooterBtn" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-gradient" id="saveAddWedding">Save</button>
            </div>
        </div>
    </div>
</div>

